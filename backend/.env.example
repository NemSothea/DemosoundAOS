# Copy to .env and fill in. Never commit .env.
# Azure portal -> your Speech resource -> Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Voices per language/gender. Each must exist in your region's voice list
# (GET /api/speech/voices shows what was validated against Azure).
AZURE_VOICE_EN_US_FEMALE=en-US-JennyNeural
AZURE_VOICE_EN_US_MALE=en-US-GuyNeural
AZURE_VOICE_KM_KH_FEMALE=km-KH-SreymomNeural
AZURE_VOICE_KM_KH_MALE=km-KH-PisethNeural

# Abuse protection
RATE_LIMIT_PER_MINUTE=10
AZURE_TIMEOUT_SECONDS=15
