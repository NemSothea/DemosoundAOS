<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the sketch, top to bottom: title, Language, Gender, Amount, Play, Free | Paid.
     Rows put the label on the left and the control on the right on screens >= 360dp wide
     (values-w360dp/styles.xml); on narrower screens the label sits above the control. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/screen_padding">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_spacing"
            android:gravity="center"
            android:text="@string/screen_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- Language -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/languageLabel"
                style="@style/FormLabel"
                android:labelFor="@id/languageDropdown"
                android:text="@string/label_language" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/languageLayout"
                style="@style/FormDropdown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/languageDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_language"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Gender -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/genderLabel"
                style="@style/FormLabel"
                android:labelFor="@id/genderDropdown"
                android:text="@string/label_gender" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/genderLayout"
                style="@style/FormDropdown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/genderDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_gender"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Currency -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/currencyLabel"
                style="@style/FormLabel"
                android:labelFor="@id/currencyDropdown"
                android:text="@string/label_currency" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/currencyLayout"
                style="@style/FormDropdown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/currencyDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_currency"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Amount -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/amountLabel"
                style="@style/FormLabel"
                android:labelFor="@id/amountInput"
                android:text="@string/label_amount" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amountLayout"
                style="@style/FormField"
                app:helperText="@string/amount_helper_usd"
                app:placeholderText="@string/amount_hint_usd"
                app:prefixText="@string/currency_prefix_usd">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/amountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789."
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="13" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:contentDescription="@string/cd_play"
            android:minHeight="56dp"
            android:text="@string/action_play"
            app:icon="@drawable/ic_play" />

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/label_mode"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <!-- Free and Paid have equal weight; the checked one is filled. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/freeButton"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/freeButton"
                style="@style/ModeButton"
                android:contentDescription="@string/cd_free"
                android:text="@string/action_free" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/paidButton"
                style="@style/ModeButton"
                android:contentDescription="@string/cd_paid"
                android:text="@string/action_paid" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/modeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/mode_free_description" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@string/cd_progress"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="@string/status_ready" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
