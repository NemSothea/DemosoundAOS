<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the Free-tab wireframe, top to bottom: FREE header, Voice source, Language,
     Voice gender, Amount (fixed preset + currency), Play, status.
     Rows put the label on the left and the control on the right on screens >= 360dp wide
     (values-w360dp/styles.xml); on narrower screens the label sits above the control. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/screen_padding">

        <!-- Header: mic icon + FREE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_spacing"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Voice source / SDK name -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/sourceLabel"
                style="@style/FormLabel"
                android:labelFor="@id/sourceDropdown"
                android:text="@string/label_source" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sourceLayout"
                style="@style/FormDropdown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/sourceDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_source"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Language -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/languageLabel"
                style="@style/FormLabel"
                android:labelFor="@id/languageDropdown"
                android:text="@string/label_language" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/languageLayout"
                style="@style/FormDropdown">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/languageDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_language"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Voice gender: Female | Male -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/genderLabel"
                style="@style/FormLabel"
                android:labelFor="@id/genderToggle"
                android:text="@string/label_gender" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/genderToggle"
                style="@style/FormControl"
                app:checkedButton="@id/femaleButton"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/femaleButton"
                    style="@style/ToggleOption"
                    android:contentDescription="@string/cd_female"
                    android:text="@string/gender_female" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/maleButton"
                    style="@style/ToggleOption"
                    android:contentDescription="@string/cd_male"
                    android:text="@string/gender_male" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Amount: fixed preset for the selected currency. No input. -->
        <LinearLayout style="@style/FormRow">

            <TextView
                android:id="@+id/amountLabel"
                style="@style/FormLabel"
                android:labelFor="@id/amountText"
                android:text="@string/label_amount" />

            <LinearLayout
                style="@style/FormControl"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/amountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_amount"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="$5" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/currencyToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:checkedButton="@id/usdButton"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/usdButton"
                        style="@style/ToggleOption"
                        android:contentDescription="@string/cd_usd"
                        android:text="@string/currency_usd" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/khrButton"
                        style="@style/ToggleOption"
                        android:contentDescription="@string/cd_khr"
                        android:text="@string/currency_khr" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- Play sound -->
        <TextView
            android:id="@+id/playLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:labelFor="@id/playButton"
            android:text="@string/label_play"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/cd_play"
            android:minHeight="56dp"
            android:text="@string/action_play"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@string/cd_progress"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="@string/status_ready" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
